{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cace.local/schema/cace-tool-bus.schema.json",
  "title": "CACE Typed Tool Bus Envelopes",
  "description": "Transport envelopes for the untrusted Local Agent Tool Bus. Tool success is orchestration/observation only and never proof promotion.",
  "$defs": {
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "call_id",
        "tool_name",
        "arguments"
      ],
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "arguments": {
          "type": "object"
        },
        "operation_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lease_id": {
          "type": "string"
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 0
        },
        "run_id": {
          "type": "string"
        }
      }
    },
    "tool_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_result_schema",
        "call_id",
        "tool_name",
        "status",
        "output",
        "error",
        "proof_effect",
        "promotion_authority"
      ],
      "properties": {
        "tool_result_schema": {
          "const": 1
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "denied",
            "invalid_request",
            "invalid_response",
            "error",
            "recovery_blocked"
          ]
        },
        "output": {
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "type": "string"
        },
        "proof_effect": {
          "const": "none"
        },
        "promotion_authority": {
          "const": false
        }
      }
    },
    "audit_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_audit_schema",
        "sequence",
        "call_id",
        "tool_name",
        "capability",
        "status",
        "approved",
        "input_sha256",
        "output_sha256",
        "error",
        "proof_effect",
        "promotion_authority"
      ],
      "properties": {
        "tool_audit_schema": {
          "const": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "denied",
            "invalid_request",
            "invalid_response",
            "error",
            "recovery_blocked"
          ]
        },
        "approved": {
          "type": "boolean"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "output_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "string"
        },
        "proof_effect": {
          "const": "none"
        },
        "promotion_authority": {
          "const": false
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/tool_call"
    },
    {
      "$ref": "#/$defs/tool_result"
    },
    {
      "$ref": "#/$defs/audit_record"
    }
  ]
}
