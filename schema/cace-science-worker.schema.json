{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cace.local/schema/cace-science-worker.schema.json",
  "title": "CACE Science Worker IPC v1",
  "description": "Strict JSON request/result contract for isolated CACE science worker processes. Runtime transport only; no proof authority.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "science_worker_request_schema",
        "experiment",
        "target_node_ids",
        "external_inputs",
        "seed",
        "gpu_enabled",
        "expected_registry_sha256",
        "control_root",
        "control_id",
        "limits",
        "parent_netns_inode",
        "sandbox_requirements",
        "parent_mntns_inode",
        "startup_gate",
        "expected_cgroup_path",
        "cgroup_prepare_report"
      ],
      "properties": {
        "science_worker_request_schema": {
          "const": 1
        },
        "experiment": {
          "type": "object"
        },
        "target_node_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "seed": {
          "type": "integer"
        },
        "gpu_enabled": {
          "type": "boolean"
        },
        "expected_registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "control_root": {
          "type": "string"
        },
        "control_id": {
          "type": "string"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_wall_seconds",
            "max_cpu_seconds",
            "max_memory_bytes",
            "max_nodes",
            "max_output_bytes",
            "max_pids",
            "max_cpu_cores"
          ],
          "properties": {
            "max_wall_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_cpu_seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_memory_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "max_nodes": {
              "type": "integer",
              "minimum": 1
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "max_pids": {
              "type": "integer",
              "minimum": 1
            },
            "max_cpu_cores": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "parent_netns_inode": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sandbox_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "require_network_namespace",
            "require_seccomp_filter",
            "require_filesystem_restriction",
            "require_privilege_hardening",
            "require_cgroup_v2",
            "require_mount_namespace",
            "require_private_tmp",
            "require_device_restrictions"
          ],
          "properties": {
            "require_network_namespace": {
              "type": "boolean"
            },
            "require_seccomp_filter": {
              "type": "boolean"
            },
            "require_filesystem_restriction": {
              "type": "boolean"
            },
            "require_privilege_hardening": {
              "type": "boolean"
            },
            "require_cgroup_v2": {
              "type": "boolean"
            },
            "require_mount_namespace": {
              "type": "boolean"
            },
            "require_private_tmp": {
              "type": "boolean"
            },
            "require_device_restrictions": {
              "type": "boolean"
            }
          }
        },
        "parent_mntns_inode": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "startup_gate": {
          "type": "string",
          "minLength": 1
        },
        "expected_cgroup_path": {
          "type": "string"
        },
        "cgroup_prepare_report": {
          "type": "object"
        }
      }
    },
    "ok_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "science_worker_result_schema",
        "status",
        "registry_sha256",
        "resource_enforcement",
        "run_result",
        "sandbox_capability_report"
      ],
      "properties": {
        "science_worker_result_schema": {
          "const": 1
        },
        "status": {
          "const": "ok"
        },
        "registry_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resource_enforcement": {
          "type": "object"
        },
        "run_result": {
          "type": "object"
        },
        "sandbox_capability_report": {
          "type": "object"
        }
      }
    },
    "error_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "science_worker_result_schema",
        "status",
        "error_type",
        "error"
      ],
      "properties": {
        "science_worker_result_schema": {
          "const": 1
        },
        "status": {
          "const": "error"
        },
        "error_type": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "sandbox_capability_report": {
          "type": "object"
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/ok_result"
    },
    {
      "$ref": "#/$defs/error_result"
    }
  ]
}
