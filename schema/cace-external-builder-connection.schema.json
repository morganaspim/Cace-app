{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cace.local/schema/cace-external-builder-connection.schema.json",
  "title": "CACE External Builder Connection Manifest v1",
  "type": "object",
  "required": [
    "schema",
    "provider",
    "role",
    "authority",
    "startup_read_order",
    "branch_policy",
    "repository_permissions",
    "change_report_required"
  ],
  "properties": {
    "schema": {
      "const": "cace-external-builder-connection-v1"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "required": [
        "scientific",
        "proof",
        "verification",
        "claim_promotion",
        "security_truth"
      ],
      "properties": {
        "scientific": {
          "const": false
        },
        "proof": {
          "const": false
        },
        "verification": {
          "const": false
        },
        "claim_promotion": {
          "const": false
        },
        "security_truth": {
          "const": false
        }
      },
      "additionalProperties": {
        "type": [
          "boolean",
          "string",
          "number",
          "object",
          "array",
          "null"
        ]
      }
    },
    "startup_read_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "branch_policy": {
      "type": "object",
      "required": [
        "registry",
        "writable_statuses",
        "main",
        "force_push",
        "merge_pull_request",
        "delete_branch"
      ],
      "properties": {
        "registry": {
          "const": "BRANCH_LIFECYCLE.json"
        },
        "writable_statuses": {
          "const": [
            "ACTIVE"
          ]
        },
        "main": {
          "const": "READ_ONLY_INTEGRATION"
        },
        "force_push": {
          "const": false
        },
        "merge_pull_request": {
          "const": false
        },
        "delete_branch": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "repository_permissions": {
      "type": "object",
      "required": [
        "direct_write_allow",
        "direct_write_deny"
      ],
      "properties": {
        "direct_write_allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "direct_write_deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "change_report_required": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
