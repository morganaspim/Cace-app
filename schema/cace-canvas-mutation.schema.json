{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cace.local/schema/cace-canvas-mutation.schema.json",
  "title": "CACE Canvas Mutation v1",
  "description": "Typed preview/commit contracts for non-proof-authoritative CACE canvas mutation.",
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "enum": [
            "add_node",
            "remove_node",
            "replace_params",
            "move_node",
            "add_edge",
            "remove_edge"
          ]
        },
        "node_id": {"type": "string"},
        "module_id": {"type": "string"},
        "params": {"type": "object"},
        "position": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [{"type": "number"}, {"type": "number"}],
              "minItems": 2,
              "maxItems": 2
            },
            {"type": "null"}
          ]
        },
        "source_node": {"type": "string"},
        "source_port": {"type": "string"},
        "target_node": {"type": "string"},
        "target_port": {"type": "string"}
      }
    },
    "preview_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/operation"}
        }
      }
    },
    "commit_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_id"],
      "properties": {
        "preview_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "preview_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_id",
        "operation_count",
        "base_semantic_sha256",
        "base_full_sha256",
        "target_semantic_sha256",
        "target_full_sha256",
        "mutation_sha256",
        "diff_sha256",
        "semantic_change",
        "diff",
        "proof_effect",
        "promotion_authority"
      ],
      "properties": {
        "preview_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "operation_count": {"type": "integer", "minimum": 1},
        "base_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_full_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_full_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mutation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_change": {"type": "boolean"},
        "diff": {"type": "object"},
        "proof_effect": {"const": "none"},
        "promotion_authority": {"const": false}
      }
    },
    "commit_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preview_id",
        "operation_id",
        "base_semantic_sha256",
        "base_full_sha256",
        "target_semantic_sha256",
        "target_full_sha256",
        "post_semantic_sha256",
        "post_full_sha256",
        "diff_sha256",
        "semantic_hash_verified",
        "full_hash_verified",
        "proof_effect",
        "promotion_authority"
      ],
      "properties": {
        "preview_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "operation_id": {"type": "string", "minLength": 1},
        "base_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_full_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_full_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "post_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "post_full_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_hash_verified": {"const": true},
        "full_hash_verified": {"const": true},
        "proof_effect": {"const": "none"},
        "promotion_authority": {"const": false}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/preview_request"},
    {"$ref": "#/$defs/commit_request"},
    {"$ref": "#/$defs/preview_response"},
    {"$ref": "#/$defs/commit_response"}
  ]
}
