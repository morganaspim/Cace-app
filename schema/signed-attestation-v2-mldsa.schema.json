{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cace.local/schema/signed-attestation-v2-mldsa.schema.json",
  "title": "CACE Signed Attestation v2 ML-DSA-65",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "signature_algorithm",
    "proof_effect",
    "canonicalization",
    "domain_separator",
    "statement_sha256",
    "statement",
    "public_key_b64",
    "signature_b64"
  ],
  "properties": {
    "schema": {
      "const": "cace-signed-attestation-v2"
    },
    "signature_algorithm": {
      "const": "ML-DSA-65"
    },
    "proof_effect": {
      "const": "none"
    },
    "canonicalization": {
      "const": "sha256/cace-canonical-json-v1"
    },
    "domain_separator": {
      "const": "CACE:TITAN:SIGNED-ATTESTATION:v2\u0000"
    },
    "statement_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_key_b64": {
      "type": "string",
      "minLength": 1
    },
    "signature_b64": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "signature_algorithm",
        "proof_effect",
        "verifier_id",
        "verifier_key_id",
        "claim_id",
        "bundle_sha256",
        "created_at_utc",
        "purpose",
        "bindings"
      ],
      "properties": {
        "schema": {
          "const": "cace-attestation-statement-v2"
        },
        "signature_algorithm": {
          "const": "ML-DSA-65"
        },
        "proof_effect": {
          "const": "none"
        },
        "verifier_id": {
          "type": "string",
          "minLength": 1
        },
        "verifier_key_id": {
          "type": "string",
          "pattern": "^ml-dsa-65:[0-9a-f]{64}$"
        },
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "purpose": {
          "enum": [
            "artifact-integrity",
            "independent-reproduction"
          ]
        },
        "bindings": {
          "type": "object",
          "required": [
            "source_repository",
            "source_commit_sha",
            "workflow_run_id",
            "provider_commit",
            "vector_source_commit",
            "verification_scope"
          ],
          "properties": {
            "source_repository": {
              "type": "string",
              "minLength": 1
            },
            "source_commit_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "workflow_run_id": {
              "type": "integer",
              "minimum": 1
            },
            "provider_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "vector_source_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "verification_scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
