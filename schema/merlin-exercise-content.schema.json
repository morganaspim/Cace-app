{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://merlin.local/schema/exercise-content.schema.json",
  "title": "Merlin Learner-Facing Exercise Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_id",
    "curriculum_id",
    "exercises"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "content_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "curriculum_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "exercises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "content_version",
          "objective",
          "prompt",
          "answer_format",
          "hints",
          "rubric",
          "transfer_prompt",
          "allowed_tools"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "content_version": {
            "type": "integer",
            "minimum": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "answer_format": {
            "enum": [
              "written_explanation",
              "table_and_explanation",
              "python_code_and_explanation",
              "conjecture_and_counterexample_search",
              "proof",
              "python_code_and_tests",
              "python_experiment_and_explanation"
            ]
          },
          "hints": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          },
          "rubric": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dimension",
                "description",
                "points"
              ],
              "properties": {
                "dimension": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                },
                "points": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            }
          },
          "transfer_prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "allowed_tools": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      }
    }
  }
}
