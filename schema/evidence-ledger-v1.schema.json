{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cace.local/schema/evidence-ledger-v1.schema.json",
  "title": "CACE Evidence Ledger v1",
  "description": "Ordered append-only ledger entries. Integrity/provenance only; no mathematical proof effect.",
  "type": "array",
  "items": {"$ref": "#/$defs/entry"},
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "chain_algorithm",
        "proof_effect",
        "sequence",
        "timestamp_utc",
        "bundle_sha256",
        "merkle_root_sha256",
        "previous_entry_sha256",
        "metadata",
        "entry_sha256"
      ],
      "properties": {
        "schema": {"const": "cace-evidence-ledger-v1"},
        "chain_algorithm": {"const": "sha256/cace-ledger-chain-v1"},
        "proof_effect": {"const": "none"},
        "sequence": {"type": "integer", "minimum": 0},
        "timestamp_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "merkle_root_sha256": {"$ref": "#/$defs/sha256"},
        "previous_entry_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "metadata": {"type": "object"},
        "entry_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
