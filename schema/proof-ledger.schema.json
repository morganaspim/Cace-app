{
  "$id": "https://cace.local/schema/proof-ledger.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "current_head_qualified": {"const": true}
              },
              "required": ["current_head_qualified"]
            },
            "then": {
              "properties": {
                "blockers": {"maxItems": 0, "type": "array"},
                "checks": {"minItems": 1, "type": "array"},
                "commit": {"pattern": "^[0-9a-fA-F]{40}$", "type": "string"},
                "proof_artifact_sha256": {"pattern": "^[0-9a-fA-F]{64}$", "type": "string"},
                "qualification_system": {"minLength": 1, "type": "string"},
                "qualification_run_id": {"minLength": 1, "type": "string"},
                "status": {"const": "PASS"}
              },
              "required": [
                "status",
                "current_head_qualified",
                "commit",
                "proof_artifact_sha256",
                "qualification_system",
                "qualification_run_id",
                "checks",
                "blockers"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "current_head_qualified": {"const": true},
                "qualification_system": {"const": "github-actions"}
              },
              "required": ["current_head_qualified", "qualification_system"]
            },
            "then": {
              "properties": {
                "workflow_run_id": {"minimum": 1, "type": "integer"}
              },
              "required": ["workflow_run_id"]
            }
          }
        ],
        "properties": {
          "blockers": {"items": {"type": "string"}, "type": "array"},
          "checks": {"items": {"type": "string"}, "type": "array"},
          "claim_ids": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array"},
          "commit": {"type": ["string", "null"]},
          "current_head_qualified": {"type": "boolean"},
          "proof_artifact_sha256": {"type": ["string", "null"]},
          "qualification_run_id": {"type": ["string", "null"]},
          "qualification_system": {"type": ["string", "null"]},
          "release": {"minLength": 1, "type": "string"},
          "status": {"type": "string"},
          "workflow_run_id": {"type": ["integer", "null"]}
        },
        "required": ["release", "claim_ids", "status", "current_head_qualified"],
        "type": "object"
      },
      "type": "array"
    },
    "policy": {"type": "string"},
    "schema_version": {"minimum": 1, "type": "integer"}
  },
  "required": ["schema_version", "policy", "entries"],
  "title": "CACE Proof Ledger",
  "type": "object"
}
