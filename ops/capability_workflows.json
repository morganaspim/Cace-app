    {
      "workflow_id": "basic_arithmetic",
      "title": "Two constants into scalar addition",
      "experiment": {
        "schema_version": 1,
        "name": "Capability Basic Arithmetic",
        "nodes": [
          {
            "id": "a",
            "module_id": "core.constant",
            "params": {
              "value": 2
            }
          },
          {
            "id": "b",
            "module_id": "core.constant",
            "params": {
              "value": 3
            }
          },
          {
            "id": "sum",
            "module_id": "core.add",
            "params": {}
          }
        ],
        "edges": [
          {
            "source_node": "a",
            "source_port": "value",
            "target_node": "sum",
            "target_port": "a"
          },
          {
            "source_node": "b",
            "source_port": "value",
            "target_node": "sum",
            "target_port": "b"
          }
        ]
      },
      "expected": {
        "completed": true,
        "outputs": {
          "sum.sum": 5
        }
      }
    },
    {
      "workflow_id": "quadratic_curvature",
      "title": "Grid to quadratic field to derivative residual check",
      "experiment": {
        "schema_version": 1,
        "name": "Capability Quadratic Curvature",
        "nodes": [
          {
            "id": "grid",
            "module_id": "science.grid1d",
            "params": {
              "start": -1,
              "stop": 1,
              "points": 101
            }
          },
          {
            "id": "field",
            "module_id": "science.quadratic",
            "params": {
              "a": 1,
              "b": 0,
              "c": 0
            }
          },
          {
            "id": "d2",
            "module_id": "science.second_derivative",
            "params": {}
          },
          {
            "id": "check",
            "module_id": "verify.constant_residual",
            "params": {
              "target": 2,
              "tolerance": 1e-9
            }
          }
        ],
        "edges": [
          {
            "source_node": "grid",
            "source_port": "x",
            "target_node": "field",
            "target_port": "x"
          },
          {
            "source_node": "grid",
            "source_port": "x",
            "target_node": "d2",
            "target_port": "x"
          },
          {
            "source_node": "field",
            "source_port": "y",
            "target_node": "d2",
            "target_port": "y"
          },
          {
            "source_node": "d2",
            "source_port": "d2y",
            "target_node": "check",
            "target_port": "values"
          }
        ]
      },
      "expected": {
        "completed": true,
        "outputs": {
          "check.verified": true
        },
        "numeric_upper_bounds": {
          "check.max_abs_residual": 1e-9
        }
      }
    },
