{
  "$id": "https://cace.local/schema/cace-kill-rule.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CACE Kill-Rule Registry",
  "description": "Pre-registered falsifiers. Each rule binds one claim to one observable that, if the stated comparison holds, makes the claim false. The rule must be registered before the outcome it judges exists. A rule is coordination evidence only; it is not proof evidence and cannot raise a claim's evidence class.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "kill_rules"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "policy": {"type": "string"},
    "kill_rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/kill_rule"}
    }
  },
  "$defs": {
    "kill_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kill_rule_id",
        "claim_id",
        "head_sha",
        "falsifier",
        "observable",
        "test",
        "verdict_bands",
        "pre_registered_at",
        "status"
      ],
      "properties": {
        "kill_rule_id": {"type": "string", "minLength": 1},
        "claim_id": {
          "type": "string",
          "minLength": 1,
          "description": "Must resolve to a claim_id in the CACE claim registry at head_sha."
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Exact lowercase 40-hex commit this rule binds to. Cross-head reuse is forbidden."
        },
        "falsifier": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence: the single observable statement that, if true, makes the claim false. If this cannot be written, the claim is not falsifiable and should not be registered."
        },
        "observable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "comparison", "threshold"],
          "properties": {
            "metric": {"type": "string", "minLength": 1},
            "unit": {"type": "string"},
            "comparison": {"enum": ["<", "<=", "==", ">=", ">", "!="]},
            "threshold": {"type": "number"},
            "sample_window": {"type": "string"}
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["procedure", "required_evidence_class"],
          "properties": {
            "procedure": {"type": "string", "minLength": 1},
            "command_or_artifact": {"type": "string"},
            "required_evidence_class": {
              "enum": ["AI_PROPOSAL", "ENGINEERING_VERIFIED", "CERTIFIED_NUMERICAL", "PROVED"]
            }
          }
        },
        "cost_stack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description", "cost_model"],
          "properties": {
            "description": {"type": "string", "minLength": 1},
            "cost_model": {"type": "string", "minLength": 1},
            "doubled_cost_net_move_pct": {"type": "number"},
            "declared": {"type": "boolean", "default": false}
          },
          "description": "Required when the verdict bands admit a bounded-survival outcome. A rule that can only die or survive without a stated cost stack is incomplete."
        },
        "verdict_bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["band", "condition"],
            "properties": {
              "band": {"enum": ["DIES", "SURVIVES_BOUNDED", "SURVIVES"]},
              "condition": {"type": "string", "minLength": 1}
            }
          }
        },
        "pre_registered_at": {"type": "string", "format": "date-time"},
        "executed_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["PRE_REGISTERED", "EXECUTED", "CLOSED"]},
        "outcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["band", "evidence_class"],
          "properties": {
            "band": {"enum": ["DIES", "SURVIVES_BOUNDED", "SURVIVES"]},
            "evidence_class": {
              "enum": ["AI_PROPOSAL", "ENGINEERING_VERIFIED", "CERTIFIED_NUMERICAL", "PROVED"]
            },
            "artifact_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
            "note": {"type": "string"}
          }
        },
        "nonclaims": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict_bands": {
                "contains": {"properties": {"band": {"const": "SURVIVES_BOUNDED"}}, "required": ["band"]}
              }
            },
            "required": ["verdict_bands"]
          },
          "then": {"required": ["cost_stack"]}
        },
        {
          "if": {"properties": {"status": {"enum": ["EXECUTED", "CLOSED"]}}, "required": ["status"]},
          "then": {"required": ["executed_at", "outcome"]}
        }
      ]
    }
  }
}
