{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:merlin:schema:continuum-structure:1",
  "title": "Merlin Continuum Structure IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "structure_id",
    "version",
    "claim",
    "geometry",
    "vertices",
    "cells",
    "state_spaces",
    "edge_fields",
    "transformations",
    "constraints",
    "invariants",
    "assumptions",
    "epistemic",
    "provenance",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "structure_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dimension",
        "orientation"
      ],
      "properties": {
        "kind": {
          "enum": [
            "simplex",
            "simplicial_complex",
            "network"
          ]
        },
        "dimension": {
          "type": "integer",
          "minimum": 1
        },
        "orientation": {
          "enum": [
            "oriented",
            "unoriented"
          ]
        }
      }
    },
    "vertices": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "coordinates",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "state": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "dimension",
          "vertex_ids",
          "orientation",
          "state_space_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "integer",
            "minimum": 1
          },
          "vertex_ids": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "orientation": {
            "enum": [
              -1,
              1
            ]
          },
          "state_space_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "state_spaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "dimension",
          "scalar_field",
          "semantics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "real_vector",
              "complex_vector",
              "discrete",
              "probability",
              "set_valued",
              "product"
            ]
          },
          "dimension": {
            "type": "integer",
            "minimum": 1
          },
          "scalar_field": {
            "enum": [
              "R",
              "C",
              "discrete",
              "probability"
            ]
          },
          "semantics": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "edge_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cell_id",
          "state_space_id",
          "parameterization",
          "samples"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "cell_id": {
            "type": "string",
            "minLength": 1
          },
          "state_space_id": {
            "type": "string",
            "minLength": 1
          },
          "parameterization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parameter",
              "domain",
              "basis"
            ],
            "properties": {
              "parameter": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "array",
                "prefixItems": [
                  {
                    "const": 0
                  },
                  {
                    "const": 1
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              },
              "basis": {
                "enum": [
                  "piecewise_linear",
                  "polynomial",
                  "piecewise_polynomial",
                  "analytic",
                  "sampled_only"
                ]
              }
            }
          },
          "samples": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "parameter",
                "value"
              ],
              "properties": {
                "parameter": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "value": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source_state_space_id",
          "target_state_space_id",
          "composition_semantics"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "linear_matrix",
              "nonlinear_map",
              "relation",
              "correspondence"
            ]
          },
          "source_state_space_id": {
            "type": "string",
            "minLength": 1
          },
          "target_state_space_id": {
            "type": "string",
            "minLength": 1
          },
          "matrix": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          },
          "composition_semantics": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "component_ids",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "endpoint_compatibility",
              "affine_extension",
              "boundary_gluing",
              "custom"
            ]
          },
          "component_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "candidate",
              "finite_tested",
              "formalized",
              "proved",
              "refuted",
              "unresolved"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "epistemic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_status",
        "finite_test_status",
        "formal_proof_status"
      ],
      "properties": {
        "claim_status": {
          "enum": [
            "candidate",
            "supported",
            "refuted",
            "unresolved"
          ]
        },
        "finite_test_status": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "mixed"
          ]
        },
        "formal_proof_status": {
          "enum": [
            "not_formalized",
            "in_progress",
            "proved",
            "refuted"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_repository",
        "source_branch",
        "source_commit",
        "source_files"
      ],
      "properties": {
        "source_repository": {
          "type": "string",
          "minLength": 1
        },
        "source_branch": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "git_blob_sha1"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "git_blob_sha1": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "repository",
          "run_id",
          "status",
          "url",
          "proof_implication"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unavailable"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "proof_implication": {
            "const": "none"
          }
        }
      }
    }
  }
}
