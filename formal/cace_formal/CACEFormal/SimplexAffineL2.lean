import Mathlib
import CACEFormal.P1RT0Element
import CACEFormal.PiecewiseDistributionalRepresentatives

namespace CACEFormal

open Set MeasureTheory

namespace Continuum

noncomputable section

/-!
# Genuine simplex-supported affine L² fields

This is the measure-theoretic source layer for the P1/RT0 bridge.  It is
dimension-generic: a simplex support is the convex hull of finitely many
vertices in Euclidean space.  Finite convex hulls are compact, hence measurable
and finite-volume.  Continuous affine coordinate functions restricted to that
support therefore give genuine L² representatives.

The distributional integration-by-parts theorem is kept as an explicit next
lemma: it requires the oriented boundary measure/current of a simplex.  This
file does not erase that boundary term.
-/

abbrev SimplexPoint (d : Nat) := Fin d → ℝ

/-- Closed simplex support generated by finitely many vertices. -/
def simplexSet {d m : Nat} (vertex : Fin m → SimplexPoint d) : Set (SimplexPoint d) :=
  convexHull ℝ (Set.range vertex)

theorem simplexSet_compact {d m : Nat} (vertex : Fin m → SimplexPoint d) :
    IsCompact (simplexSet vertex) := by
  exact (Set.finite_range vertex).isCompact_convexHull ℝ

theorem simplexSet_measurable {d m : Nat} (vertex : Fin m → SimplexPoint d) :
    MeasurableSet (simplexSet vertex) :=
  (simplexSet_compact vertex).isClosed.measurableSet

theorem simplexSet_volume_lt_top {d m : Nat} (vertex : Fin m → SimplexPoint d) :
    volume (simplexSet vertex) < ⊤ :=
  (simplexSet_compact vertex).measure_lt_top

/-- Dimension-generic affine scalar polynomial. -/
structure AffineScalar (d : Nat) where
  c : ℝ
  grad : Fin d → ℝ

namespace AffineScalar

def eval {d : Nat} (u : AffineScalar d) (x : SimplexPoint d) : ℝ :=
  u.c + ∑ i, u.grad i * x i

theorem continuous_eval {d : Nat} (u : AffineScalar d) :
    Continuous u.eval := by
  unfold eval
  fun_prop

end AffineScalar

/-- RT0 affine field q(x)=c+r x in arbitrary finite dimension. -/
structure RT0AffineND (d : Nat) where
  c : Fin d → ℝ
  radial : ℝ

namespace RT0AffineND

def eval {d : Nat} (q : RT0AffineND d) (x : SimplexPoint d) : SimplexPoint d :=
  fun i => q.c i + q.radial * x i

def divergence {d : Nat} (q : RT0AffineND d) : ℝ :=
  (d : ℝ) * q.radial

theorem continuous_eval {d : Nat} (q : RT0AffineND d) :
    Continuous q.eval := by
  unfold eval
  fun_prop

end RT0AffineND

def simplexSupportedScalar {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (u : AffineScalar d) :
    SimplexPoint d → ℝ :=
  (simplexSet vertex).indicator u.eval

def simplexSupportedRT0 {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (q : RT0AffineND d) :
    SimplexPoint d → SimplexPoint d :=
  (simplexSet vertex).indicator q.eval

def simplexSupportedDiv {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (q : RT0AffineND d) :
    SimplexPoint d → ℝ :=
  (simplexSet vertex).indicator (fun _ => q.divergence)

/--
A continuous function restricted to a compact simplex is L².  This reusable
lemma avoids any coordinate-specific bounding calculation.
-/
theorem continuous_indicator_simplex_memLp_two
    {d m : Nat} (vertex : Fin m → SimplexPoint d)
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E]
    (f : SimplexPoint d → E) (hf : Continuous f) :
    MemLp ((simplexSet vertex).indicator f) 2 volume := by
  have hmeas : MeasurableSet (simplexSet vertex) := simplexSet_measurable vertex
  have hcompact : IsCompact (simplexSet vertex) := simplexSet_compact vertex
  have hcont : ContinuousOn f (simplexSet vertex) := hf.continuousOn
  have hbounded : HasCompactSupport ((simplexSet vertex).indicator f) := by
    rw [HasCompactSupport]
    refine hcompact.of_isClosed_subset isClosed_closure ?_
    refine closure_minimal ?_ hcompact.isClosed
    intro x hx
    by_contra hxs
    exact hx (Set.indicator_of_notMem hxs f)
  obtain ⟨C, hC⟩ := hcompact.exists_bound_of_continuousOn hcont
  exact hbounded.memLp_of_bound
    (hf.aestronglyMeasurable.indicator hmeas)
    (max C 0)
    (Filter.Eventually.of_forall fun x => by
      by_cases hx : x ∈ simplexSet vertex
      · have hCx : ‖f x‖ ≤ max C 0 := (hC x hx).trans (le_max_left C 0)
        simpa [Set.indicator_of_mem hx] using hCx
      · have hC0 : 0 ≤ max C 0 := le_max_right C 0
        simpa [Set.indicator_of_notMem hx] using hC0)

theorem simplexSupportedScalar_memLp_two {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (u : AffineScalar d) :
    MemLp (simplexSupportedScalar vertex u) 2 volume := by
  exact continuous_indicator_simplex_memLp_two vertex u.eval u.continuous_eval

theorem simplexSupportedRT0_memLp_two {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (q : RT0AffineND d) :
    MemLp (simplexSupportedRT0 vertex q) 2 volume := by
  exact continuous_indicator_simplex_memLp_two vertex q.eval q.continuous_eval

theorem simplexSupportedDiv_memLp_two {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (q : RT0AffineND d) :
    MemLp (simplexSupportedDiv vertex q) 2 volume := by
  exact continuous_indicator_simplex_memLp_two vertex
    (fun _ => q.divergence) continuous_const

/-- Genuine L² scalar representative of a simplex-supported affine P1 field. -/
noncomputable def simplexScalarL2 {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (u : AffineScalar d) :
    Lp ℝ 2 (volume : Measure (SimplexPoint d)) :=
  (simplexSupportedScalar_memLp_two vertex u).toLp (simplexSupportedScalar vertex u)

/-- Genuine L² vector representative of a simplex-supported RT0 field. -/
noncomputable def simplexRT0L2 {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (q : RT0AffineND d) :
    Lp (SimplexPoint d) 2 (volume : Measure (SimplexPoint d)) :=
  (simplexSupportedRT0_memLp_two vertex q).toLp (simplexSupportedRT0 vertex q)

/-- Genuine L² representative of the cellwise RT0 divergence. -/
noncomputable def simplexDivL2 {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (q : RT0AffineND d) :
    Lp ℝ 2 (volume : Measure (SimplexPoint d)) :=
  (simplexSupportedDiv_memLp_two vertex q).toLp (simplexSupportedDiv vertex q)


/-- Scalar L² representative of one constant P1 gradient coordinate on a simplex. -/
noncomputable def simplexGradComponentL2 {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (u : AffineScalar d) (i : Fin d) :
    Lp ℝ 2 (volume : Measure (SimplexPoint d)) := by
  let f : SimplexPoint d → ℝ := fun _ => u.grad i
  exact (continuous_indicator_simplex_memLp_two vertex f continuous_const).toLp
    ((simplexSet vertex).indicator f)

/-- One RT0 coordinate restricted to the simplex is a genuine scalar L² function. -/
theorem simplexSupportedRT0Component_memLp_two {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (q : RT0AffineND d) (i : Fin d) :
    MemLp ((simplexSet vertex).indicator (fun x => q.eval x i)) 2 volume := by
  apply continuous_indicator_simplex_memLp_two vertex
  exact continuous_apply i q.continuous_eval

/-- Scalar L² representative of one RT0 field coordinate on a simplex. -/
noncomputable def simplexRT0ComponentL2 {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (q : RT0AffineND d) (i : Fin d) :
    Lp ℝ 2 (volume : Measure (SimplexPoint d)) :=
  (simplexSupportedRT0Component_memLp_two vertex q i).toLp
    ((simplexSet vertex).indicator (fun x => q.eval x i))

/--
All source coordinates required by the H¹/H(div) graph representation are now
available as genuine scalar L² objects: P1 value, every P1 gradient component,
every RT0 field component, and the RT0 divergence.  This theorem is an explicit
packaging lemma for the subsequent distributional graph construction.
-/
theorem simplex_affine_source_coordinates_memLp_two {d m : Nat}
    (vertex : Fin m → SimplexPoint d) (u : AffineScalar d) (q : RT0AffineND d) :
    MemLp (simplexSupportedScalar vertex u) 2 volume ∧
    (∀ i : Fin d,
      MemLp ((simplexSet vertex).indicator (fun _ => u.grad i)) 2 volume) ∧
    (∀ i : Fin d,
      MemLp ((simplexSet vertex).indicator (fun x => q.eval x i)) 2 volume) ∧
    MemLp (simplexSupportedDiv vertex q) 2 volume := by
  refine ⟨simplexSupportedScalar_memLp_two vertex u, ?_, ?_,
    simplexSupportedDiv_memLp_two vertex q⟩
  · intro i
    exact continuous_indicator_simplex_memLp_two vertex (fun _ => u.grad i) continuous_const
  · intro i
    exact simplexSupportedRT0Component_memLp_two vertex q i

end

end Continuum

end CACEFormal
