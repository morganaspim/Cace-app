import CACEFormal.PDEDomainBridge
import Mathlib.MeasureTheory.Measure.Typeclasses.Finite

namespace CACEFormal

open Set Finset MeasureTheory
open scoped BigOperators LineDeriv SchwartzMap

namespace Continuum

noncomputable section

/-!
# Bounded-box graph closure and normal-trace core

This module builds a domain-honest graph model directly on the rectangular box used by the
classical divergence theorem.  It intentionally does not identify `BoxPoint` with the whole-space
`EuclideanDomain`: the box theory is constructed over the same plain Pi-space on which
`smoothBoxNormalTrace` is defined.
-/

/-- Volume measure restricted to the closed rectangular box `[a,b]`. -/
noncomputable def boxVolume {n : Nat} (a b : BoxPoint n) : Measure (BoxPoint n) :=
  (volume : Measure (BoxPoint n)).restrict (Icc a b)

/-- A rectangular box has finite restricted volume. -/
noncomputable instance boxVolume_isFinite {n : Nat} (a b : BoxPoint n) :
    IsFiniteMeasure (boxVolume a b) where
  measure_univ_lt_top := by
    simp [boxVolume, isCompact_Icc.measure_lt_top (μ := (volume : Measure (BoxPoint n)))]

/-- Real L² on a rectangular box. -/
abbrev BoxL2 {n : Nat} (a b : BoxPoint n) :=
  Lp ℝ 2 (boxVolume a b)

/-- Smooth scalar fields used as the box graph core. -/
abbrev BoxSmoothScalar (n : Nat) := 𝓢(BoxPoint n, ℝ)

/-- Smooth vector fields used as the box H(div) graph core. -/
abbrev BoxSmoothVector (n : Nat) := Fin (n + 1) → BoxSmoothScalar n

/-- Coordinate direction in the plain Pi-space underlying a box. -/
noncomputable def boxBasisVector {n : Nat} (i : Fin (n + 1)) : BoxPoint n :=
  Pi.single i (1 : ℝ)

/-- H¹ graph coordinates `(u, ∇u)` over the restricted box measure. -/
abbrev BoxH1GraphAmbient {n : Nat} (a b : BoxPoint n) :=
  BoxL2 a b × (Fin (n + 1) → BoxL2 a b)

/-- H(div) graph coordinates `(q, div q)` over the restricted box measure. -/
abbrev BoxHDivGraphAmbient {n : Nat} (a b : BoxPoint n) :=
  (Fin (n + 1) → BoxL2 a b) × BoxL2 a b

/-- Schwartz-to-L² map for the restricted box measure. -/
noncomputable def boxSchwartzL2 {n : Nat} (a b : BoxPoint n) :
    BoxSmoothScalar n →L[ℝ] BoxL2 a b :=
  SchwartzMap.toLpCLM ℝ ℝ 2 (boxVolume a b)

/-- Smooth box H¹ graph map. -/
noncomputable def smoothBoxH1GraphMap {n : Nat} (a b : BoxPoint n) :
    BoxSmoothScalar n →ₗ[ℝ] BoxH1GraphAmbient a b where
  toFun u :=
    (boxSchwartzL2 a b u,
      fun i => boxSchwartzL2 a b (∂_{boxBasisVector i} u))
  map_add' u v := by
    apply Prod.ext
    · simp
    · funext i
      simp [LineDeriv.lineDerivOp_add]
  map_smul' c u := by
    apply Prod.ext
    · simp
    · funext i
      simp [LineDeriv.lineDerivOp_smul]

/-- Smooth box H(div) graph map. -/
noncomputable def smoothBoxHDivGraphMap {n : Nat} (a b : BoxPoint n) :
    BoxSmoothVector n →ₗ[ℝ] BoxHDivGraphAmbient a b where
  toFun q :=
    (fun i => boxSchwartzL2 a b (q i),
      ∑ i : Fin (n + 1), boxSchwartzL2 a b (∂_{boxBasisVector i} (q i)))
  map_add' q r := by
    apply Prod.ext
    · funext i
      simp
    · simp [LineDeriv.lineDerivOp_add, Finset.sum_add_distrib]
  map_smul' c q := by
    apply Prod.ext
    · funext i
      simp
    · simp [LineDeriv.lineDerivOp_smul, Finset.smul_sum]

/-- Smooth scalar graph core on the box. -/
noncomputable def BoxH1SmoothGraphCore {n : Nat} (a b : BoxPoint n) :
    Submodule ℝ (BoxH1GraphAmbient a b) :=
  LinearMap.range (smoothBoxH1GraphMap a b)

/-- Smooth H(div) graph core on the box. -/
noncomputable def BoxHDivSmoothGraphCore {n : Nat} (a b : BoxPoint n) :
    Submodule ℝ (BoxHDivGraphAmbient a b) :=
  LinearMap.range (smoothBoxHDivGraphMap a b)

/-- Closed box H¹ graph space generated by smooth fields. -/
abbrev BoxH1GraphClosedSpace {n : Nat} (a b : BoxPoint n) :=
  (BoxH1SmoothGraphCore a b).topologicalClosure

/-- Closed box H(div) graph space generated by smooth fields. -/
abbrev BoxHDivGraphClosedSpace {n : Nat} (a b : BoxPoint n) :=
  (BoxHDivSmoothGraphCore a b).topologicalClosure

/-- Smooth H¹ core viewed inside its graph closure. -/
noncomputable def BoxH1DenseSmoothCore {n : Nat} (a b : BoxPoint n) :
    Submodule ℝ (BoxH1GraphClosedSpace a b) :=
  coreInClosure (BoxH1SmoothGraphCore a b)

/-- Smooth H(div) core viewed inside its graph closure. -/
noncomputable def BoxHDivDenseSmoothCore {n : Nat} (a b : BoxPoint n) :
    Submodule ℝ (BoxHDivGraphClosedSpace a b) :=
  coreInClosure (BoxHDivSmoothGraphCore a b)

/-- The smooth scalar graph core is dense in the closed box H¹ graph space. -/
theorem dense_BoxH1DenseSmoothCore {n : Nat} (a b : BoxPoint n) :
    Dense (BoxH1DenseSmoothCore a b : Set (BoxH1GraphClosedSpace a b)) :=
  dense_coreInClosure (BoxH1SmoothGraphCore a b)

/-- The smooth vector graph core is dense in the closed box H(div) graph space. -/
theorem dense_BoxHDivDenseSmoothCore {n : Nat} (a b : BoxPoint n) :
    Dense (BoxHDivDenseSmoothCore a b : Set (BoxHDivGraphClosedSpace a b)) :=
  dense_coreInClosure (BoxHDivSmoothGraphCore a b)

end

end Continuum

end CACEFormal
