import CACEFormal.GraphDensity
import Mathlib.Topology.Algebra.Module.Basic

namespace CACEFormal

namespace Continuum

/-- A submodule viewed inside its own topological closure. -/
noncomputable def coreInClosure
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (S : Submodule ℝ E) : Submodule ℝ S.topologicalClosure :=
  S.comap S.topologicalClosure.subtype

/-- The original core is dense when viewed inside its topological closure. -/
theorem dense_coreInClosure
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (S : Submodule ℝ E) :
    Dense (coreInClosure S : Set S.topologicalClosure) := by
  rw [Subtype.dense_iff]
  have himage :
      ((fun x : S.topologicalClosure => (x : E)) ''
        (coreInClosure S : Set S.topologicalClosure)) = (S : Set E) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      refine ⟨⟨x, S.le_topologicalClosure hx⟩, ?_, rfl⟩
      exact hx
  rw [himage]
  rfl

/-- Closed H¹ graph space generated by smooth scalar graph data. -/
abbrev H1GraphClosedSpace (n : Nat) :=
  (H1SmoothGraphCore n).topologicalClosure

/-- Closed H(div) graph space generated by smooth vector graph data. -/
abbrev HDivGraphClosedSpace (n : Nat) :=
  (HDivSmoothGraphCore n).topologicalClosure

/-- Smooth H¹ core as a dense submodule of the closed H¹ graph space. -/
noncomputable def H1DenseSmoothCore (n : Nat) :
    Submodule ℝ (H1GraphClosedSpace n) :=
  coreInClosure (H1SmoothGraphCore n)

/-- Smooth H(div) core as a dense submodule of the closed H(div) graph space. -/
noncomputable def HDivDenseSmoothCore (n : Nat) :
    Submodule ℝ (HDivGraphClosedSpace n) :=
  coreInClosure (HDivSmoothGraphCore n)

/-- Concrete density of the smooth H¹ core in the closed graph space. -/
theorem dense_H1DenseSmoothCore (n : Nat) :
    Dense (H1DenseSmoothCore n : Set (H1GraphClosedSpace n)) :=
  dense_coreInClosure (H1SmoothGraphCore n)

/-- Concrete density of the smooth H(div) core in the closed graph space. -/
theorem dense_HDivDenseSmoothCore (n : Nat) :
    Dense (HDivDenseSmoothCore n : Set (HDivGraphClosedSpace n)) :=
  dense_coreInClosure (HDivSmoothGraphCore n)

end Continuum

end CACEFormal
