import Mathlib
import CACEFormal.SimplexDistributionEvaluation
import CACEFormal.ReferenceSimplexFacetCurrentClosure

namespace CACEFormal

open Set MeasureTheory
open scoped BigOperators LineDeriv SchwartzMap

namespace Continuum

noncomputable section

/-!
# Exact local P1/RT0 integration by parts on the reference simplex

This module is the four-group combinatorial closure

1. explicit reference-simplex Gauss--Green,
2. geometric facet-current identification,
3. real L² simplex representatives,
4. the generic simplex distribution bridge.

The result fills the exact local obligations already required by
`SimplexCellDistributionBridge`: the canonical reference simplex now carries
actual `GeometricSimplexP1CellIBP` and `GeometricSimplexRT0CellIBP`
certificates.
-/

/-- The L² simplex support generated by the canonical reference vertices is the reference simplex. -/
theorem referenceSimplex_euclideanSimplexSet_eq
    (d : Nat) :
    euclideanSimplexSet (referenceGeometricSimplex d).points =
      euclideanReferenceSimplex d := by
  unfold euclideanSimplexSet
  rw [← geometricSimplexCell_eq_convexHull (referenceGeometricSimplex d)]
  exact referenceGeometricSimplex_cell_eq_referenceSimplex d

/-- Concrete P1 value-distribution evaluation on the reference simplex. -/
theorem referenceSimplexP1ValueDistribution_apply
    {d : Nat} [NeZero d]
    (u : AffineScalar d) (φ : 𝓢(EuclideanDomain d, ℂ)) :
    geometricSimplexP1ValueDistribution
        (referenceGeometricSimplex d) u φ =
      ∫ x,
        (euclideanReferenceSimplex d).indicator
          (fun x => euclideanAffineScalarEval u x • φ x) x := by
  rw [geometricSimplexP1ValueDistribution_apply,
    referenceSimplex_euclideanSimplexSet_eq]
  apply integral_congr_ae
  filter_upwards with x
  by_cases hx : x ∈ euclideanReferenceSimplex d
  · simp [Set.indicator_of_mem hx, Algebra.smul_def, mul_comm]
  · simp [Set.indicator_of_notMem hx]

/-- Concrete P1 gradient-distribution evaluation on the reference simplex. -/
theorem referenceSimplexP1GradientDistribution_apply
    {d : Nat} [NeZero d]
    (u : AffineScalar d) (i : Fin d)
    (φ : 𝓢(EuclideanDomain d, ℂ)) :
    geometricSimplexP1GradientDistribution
        (referenceGeometricSimplex d) u i φ =
      ∫ x,
        (euclideanReferenceSimplex d).indicator
          (fun x => u.grad i • φ x) x := by
  rw [geometricSimplexP1GradientDistribution_apply,
    referenceSimplex_euclideanSimplexSet_eq]
  apply integral_congr_ae
  filter_upwards with x
  by_cases hx : x ∈ euclideanReferenceSimplex d
  · simp [Set.indicator_of_mem hx, Algebra.smul_def, mul_comm]
  · simp [Set.indicator_of_notMem hx]

/-- Concrete RT0 component-distribution evaluation on the reference simplex. -/
theorem referenceSimplexRT0FieldDistribution_apply
    {d : Nat} [NeZero d]
    (q : RT0AffineND d) (i : Fin d)
    (φ : 𝓢(EuclideanDomain d, ℂ)) :
    geometricSimplexRT0FieldDistribution
        (referenceGeometricSimplex d) q i φ =
      ∫ x,
        (euclideanReferenceSimplex d).indicator
          (fun x => euclideanRT0ComponentEval q i x • φ x) x := by
  rw [geometricSimplexRT0FieldDistribution_apply,
    referenceSimplex_euclideanSimplexSet_eq]
  apply integral_congr_ae
  filter_upwards with x
  by_cases hx : x ∈ euclideanReferenceSimplex d
  · simp [Set.indicator_of_mem hx, Algebra.smul_def, mul_comm]
  · simp [Set.indicator_of_notMem hx]

/-- Concrete RT0 divergence-distribution evaluation on the reference simplex. -/
theorem referenceSimplexRT0DivergenceDistribution_apply
    {d : Nat} [NeZero d]
    (q : RT0AffineND d) (φ : 𝓢(EuclideanDomain d, ℂ)) :
    geometricSimplexRT0DivergenceDistribution
        (referenceGeometricSimplex d) q φ =
      ∫ x,
        (euclideanReferenceSimplex d).indicator
          (fun x => q.divergence • φ x) x := by
  rw [geometricSimplexRT0DivergenceDistribution_apply,
    referenceSimplex_euclideanSimplexSet_eq]
  apply integral_congr_ae
  filter_upwards with x
  by_cases hx : x ∈ euclideanReferenceSimplex d
  · simp [Set.indicator_of_mem hx, Algebra.smul_def, mul_comm]
  · simp [Set.indicator_of_notMem hx]

/--
The canonical reference simplex satisfies the exact P1 local
distributional Gauss--Green obligation.
-/
theorem referenceGeometricSimplexP1CellIBP
    {d : Nat} [NeZero d] (u : AffineScalar d) :
    GeometricSimplexP1CellIBP (referenceGeometricSimplex d) u := by
  constructor
  intro i
  ext φ
  change
    (weakPartial i
      (geometricSimplexP1ValueDistribution
        (referenceGeometricSimplex d) u)) φ =
      (geometricSimplexP1GradientDistribution
          (referenceGeometricSimplex d) u i) φ -
        (geometricSimplexP1BoundaryDistribution
          (referenceGeometricSimplex d) u i) φ
  change
    (∂_{simplexBasisVector i}
      (geometricSimplexP1ValueDistribution
        (referenceGeometricSimplex d) u)) φ = _
  rw [simplex_distributional_partial_apply]
  simp only [simplexBasisVector]
  rw [referenceSimplexP1ValueDistribution_apply]
  rw [referenceSimplexP1GradientDistribution_apply]
  rw [referenceSimplexP1BoundaryDistribution_apply_eq_endpoint]
  exact referenceSimplexP1_gaussGreen_endpoint u φ i

/--
The canonical reference simplex satisfies the exact RT0 local divergence
Gauss--Green obligation.
-/
theorem referenceGeometricSimplexRT0CellIBP
    {d : Nat} [NeZero d] (q : RT0AffineND d) :
    GeometricSimplexRT0CellIBP (referenceGeometricSimplex d) q := by
  constructor
  ext φ
  change
    (distributionalDivergence
      (fun i =>
        geometricSimplexRT0FieldDistribution
          (referenceGeometricSimplex d) q i)) φ =
      (geometricSimplexRT0DivergenceDistribution
        (referenceGeometricSimplex d) q) φ -
        (geometricSimplexRT0BoundaryDistribution
          (referenceGeometricSimplex d) q) φ
  calc
    (distributionalDivergence
      (fun i =>
        geometricSimplexRT0FieldDistribution
          (referenceGeometricSimplex d) q i)) φ =
        ∑ i : Fin d,
          -(∫ x,
            (euclideanReferenceSimplex d).indicator
              (fun x =>
                euclideanRT0ComponentEval q i x •
                  (∂_{basisVector i} φ) x) x) := by
      unfold distributionalDivergence
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i hi
      change
        (weakPartial i
          (geometricSimplexRT0FieldDistribution
            (referenceGeometricSimplex d) q i)) φ = _
      change
        (∂_{simplexBasisVector i}
          (geometricSimplexRT0FieldDistribution
            (referenceGeometricSimplex d) q i)) φ = _
      rw [simplex_distributional_partial_apply]
      simp only [simplexBasisVector]
      rw [referenceSimplexRT0FieldDistribution_apply]
    _ =
        -(∑ i : Fin d,
          ∫ x,
            (euclideanReferenceSimplex d).indicator
              (fun x =>
                euclideanRT0ComponentEval q i x •
                  (∂_{basisVector i} φ) x) x) := by
      rw [Finset.sum_neg_distrib]
    _ =
        (∫ x,
          (euclideanReferenceSimplex d).indicator
            (fun x => q.divergence • φ x) x) -
          referenceSimplexRT0TotalEndpointBoundary q φ :=
      referenceSimplexRT0_divergence_gaussGreen_endpoint q φ
    _ =
        (geometricSimplexRT0DivergenceDistribution
            (referenceGeometricSimplex d) q) φ -
          (geometricSimplexRT0BoundaryDistribution
            (referenceGeometricSimplex d) q) φ := by
      rw [referenceSimplexRT0DivergenceDistribution_apply]
      rw [referenceSimplexRT0BoundaryDistribution_apply_eq_endpoint]

end

end Continuum

end CACEFormal
