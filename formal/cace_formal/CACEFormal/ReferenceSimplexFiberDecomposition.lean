import Mathlib
import CACEFormal.ReferenceSimplexFiberCalculus

namespace CACEFormal

open Set
open scoped BigOperators

namespace Continuum

noncomputable section

/-!
# Orthogonal decomposition of reference-simplex coordinate fibers

For Fubini we split the Euclidean ambient into the coordinate line
`ℝ ∙ e_i` and its orthogonal hyperplane.  The zero-coordinate representative
of a fiber lies in that hyperplane, and every point is reconstructed exactly by
adding its selected coordinate along `e_i`.

This isolates the measure-theoretic decomposition needed by the later
reference-simplex Gauss--Green proof.
-/

/-- The one-dimensional subspace generated by the canonical basis vector `e_i`. -/
def referenceSimplexCoordinateLine {d : Nat} (i : Fin d) :
    Submodule ℝ (EuclideanDomain d) :=
  ℝ ∙ basisVector i

/-- The canonical coordinate basis vector is nonzero. -/
theorem basisVector_ne_zero {d : Nat} (i : Fin d) :
    basisVector i ≠ 0 := by
  intro h
  have hi := congrArg (fun x : EuclideanDomain d => EuclideanSpace.proj i x) h
  simpa [basisVector] using hi

/--
The orthogonal complement of the coordinate line is exactly the coordinate
hyperplane where the selected coordinate vanishes.
-/
theorem mem_referenceSimplexCoordinateLine_orthogonal_iff
    {d : Nat} (i : Fin d) (x : EuclideanDomain d) :
    x ∈ (referenceSimplexCoordinateLine i)ᗮ ↔
      EuclideanSpace.proj i x = 0 := by
  rw [referenceSimplexCoordinateLine,
    Submodule.mem_orthogonal_singleton_iff_inner_right]
  simp [basisVector, EuclideanSpace.inner_single_left]

/-- Zero-coordinate representative of the `i`-th coordinate fiber. -/
noncomputable def referenceSimplexFiberBasePoint {d : Nat}
    (i : Fin d) (x : EuclideanDomain d) : EuclideanDomain d :=
  referenceSimplexFiberPoint i x 0

/-- The selected coordinate of the fiber base point is zero. -/
@[simp]
theorem referenceSimplexFiberBasePoint_proj_same
    {d : Nat} (i : Fin d) (x : EuclideanDomain d) :
    EuclideanSpace.proj i (referenceSimplexFiberBasePoint i x) = 0 := by
  simp [referenceSimplexFiberBasePoint]

/-- Every nonselected coordinate is unchanged by passage to the fiber base point. -/
theorem referenceSimplexFiberBasePoint_proj_ne
    {d : Nat} (i j : Fin d) (x : EuclideanDomain d) (hji : j ≠ i) :
    EuclideanSpace.proj j (referenceSimplexFiberBasePoint i x) =
      EuclideanSpace.proj j x := by
  exact referenceSimplexFiberPoint_proj_ne i j x 0 hji

/-- The fiber base point lies in the orthogonal hyperplane to `e_i`. -/
theorem referenceSimplexFiberBasePoint_mem_orthogonal
    {d : Nat} (i : Fin d) (x : EuclideanDomain d) :
    referenceSimplexFiberBasePoint i x ∈
      (referenceSimplexCoordinateLine i)ᗮ := by
  rw [mem_referenceSimplexCoordinateLine_orthogonal_iff]
  exact referenceSimplexFiberBasePoint_proj_same i x

/-- The nonselected-coordinate sum is unchanged at the fiber base point. -/
@[simp]
theorem referenceSimplexOtherCoordinateSum_basePoint
    {d : Nat} (i : Fin d) (x : EuclideanDomain d) :
    referenceSimplexOtherCoordinateSum i
        (referenceSimplexFiberBasePoint i x) =
      referenceSimplexOtherCoordinateSum i x := by
  simp [referenceSimplexFiberBasePoint]

/-- The fiber upper endpoint is unchanged at the fiber base point. -/
@[simp]
theorem referenceSimplexFiberUpper_basePoint
    {d : Nat} (i : Fin d) (x : EuclideanDomain d) :
    referenceSimplexFiberUpper i (referenceSimplexFiberBasePoint i x) =
      referenceSimplexFiberUpper i x := by
  simp [referenceSimplexFiberBasePoint]

/-- Passing to the base point twice is idempotent. -/
@[simp]
theorem referenceSimplexFiberBasePoint_idem
    {d : Nat} (i : Fin d) (x : EuclideanDomain d) :
    referenceSimplexFiberBasePoint i (referenceSimplexFiberBasePoint i x) =
      referenceSimplexFiberBasePoint i x := by
  ext j
  by_cases hji : j = i
  · subst j
    simp
  · rw [referenceSimplexFiberBasePoint_proj_ne i j
        (referenceSimplexFiberBasePoint i x) hji,
      referenceSimplexFiberBasePoint_proj_ne i j x hji]

/--
Every point is reconstructed exactly from its zero-coordinate base point and
its original selected coordinate.
-/
theorem referenceSimplexFiber_reconstruct
    {d : Nat} (i : Fin d) (x : EuclideanDomain d) :
    referenceSimplexFiberPoint i
        (referenceSimplexFiberBasePoint i x)
        (EuclideanSpace.proj i x) = x := by
  ext j
  by_cases hji : j = i
  · subst j
    simp
  · rw [referenceSimplexFiberPoint_proj_ne i j
        (referenceSimplexFiberBasePoint i x)
        (EuclideanSpace.proj i x) hji,
      referenceSimplexFiberBasePoint_proj_ne i j x hji]

/-- A simplex point has a simplex-valued base point. -/
theorem referenceSimplexFiberBasePoint_mem_of_mem
    {d : Nat} (i : Fin d) {x : EuclideanDomain d}
    (hx : x ∈ euclideanReferenceSimplex d) :
    referenceSimplexFiberBasePoint i x ∈ euclideanReferenceSimplex d := by
  have hf := (mem_euclideanReferenceSimplex_iff_fiber i x).mp hx
  exact referenceSimplexFiberPoint_zero_mem i x hf.1 (hf.2.1.trans hf.2.2)

/--
For a simplex point, its original selected coordinate lies in the exact
admissible fiber interval over the base point.
-/
theorem referenceSimplexFiber_parameter_mem_interval
    {d : Nat} (i : Fin d) {x : EuclideanDomain d}
    (hx : x ∈ euclideanReferenceSimplex d) :
    EuclideanSpace.proj i x ∈
      Set.Icc 0
        (referenceSimplexFiberUpper i
          (referenceSimplexFiberBasePoint i x)) := by
  have hf := (mem_euclideanReferenceSimplex_iff_fiber i x).mp hx
  simpa using hf.2

/--
Conversely, a base point in the coordinate hyperplane with admissible
nonselected coordinates generates precisely the simplex fiber interval.
-/
theorem referenceSimplexFiber_from_base_mem_iff
    {d : Nat} (i : Fin d) (y : EuclideanDomain d)
    (_hyi : EuclideanSpace.proj i y = 0)
    (hother :
      ∀ j ∈ Finset.univ.erase i, 0 ≤ EuclideanSpace.proj j y)
    (t : ℝ) :
    referenceSimplexFiberPoint i y t ∈ euclideanReferenceSimplex d ↔
      t ∈ Set.Icc 0 (referenceSimplexFiberUpper i y) := by
  exact referenceSimplexFiberPoint_mem_iff i y t hother

end

end Continuum

end CACEFormal
