import Mathlib
import CACEFormal.ReferenceSimplexEndpointGeometry
import CACEFormal.SimplexFacetMeasure

namespace CACEFormal

open Set MeasureTheory
open scoped BigOperators MeasureTheory RealInnerProductSpace

namespace Continuum

noncomputable section

/-!
# Coordinate-facet surface measure of the reference simplex

For coordinate `i`, the lower endpoint hyperplane is exactly
`(ℝ ∙ eᵢ)ᗮ`.  Its intrinsic volume therefore pushes forward under subtype
inclusion to the normalized ambient codimension-one Euclidean Hausdorff measure.

Restricting this identity to the admissible base domain gives the exact surface
measure on the coordinate facet opposite vertex `i.succ`.
-/

/-- The coordinate line generated by `eᵢ` has dimension one. -/
theorem referenceSimplexCoordinateLine_finrank
    {d : Nat} (i : Fin d) :
    Module.finrank ℝ (referenceSimplexCoordinateLine i) = 1 := by
  exact finrank_span_singleton (basisVector_ne_zero i)

/-- The orthogonal coordinate hyperplane has the expected codimension-one dimension. -/
theorem referenceSimplexCoordinateLine_orthogonal_finrank
    {d : Nat} [NeZero d] (i : Fin d) :
    Module.finrank ℝ ((referenceSimplexCoordinateLine i)ᗮ) = d - 1 := by
  have hsum :=
    (referenceSimplexCoordinateLine i).finrank_add_finrank_orthogonal
  have hline := referenceSimplexCoordinateLine_finrank i
  have hambient :
      Module.finrank ℝ (EuclideanDomain d) = d := by
    simp [EuclideanDomain]
  rw [hline, hambient] at hsum
  omega

/-- The coordinate facet pulls back under hyperplane inclusion to the admissible base domain. -/
theorem referenceSimplex_coordinateFacet_preimage
    {d : Nat} [NeZero d] (i : Fin d) :
    ((fun y : (referenceSimplexCoordinateLine i)ᗮ =>
        (y : EuclideanDomain d)) ⁻¹'
      geometricSimplexFacet (referenceGeometricSimplex d) i.succ) =
        referenceSimplexFiberBaseDomain i := by
  ext y
  rw [Set.mem_preimage,
    mem_referenceGeometricSimplex_coordinateFacet_iff,
    mem_referenceSimplexFiberBaseDomain_iff]
  simp [referenceSimplexBase_proj_eq_zero i y]

/-- Every point of the coordinate facet lies in the orthogonal hyperplane range. -/
theorem referenceSimplex_coordinateFacet_subset_orthogonal_range
    {d : Nat} [NeZero d] (i : Fin d) :
    geometricSimplexFacet (referenceGeometricSimplex d) i.succ ⊆
      Set.range
        (fun y : (referenceSimplexCoordinateLine i)ᗮ =>
          (y : EuclideanDomain d)) := by
  intro x hx
  have hcoord :=
    (mem_referenceGeometricSimplex_coordinateFacet_iff i x).mp hx
  have hxorth :
      x ∈ (referenceSimplexCoordinateLine i)ᗮ :=
    (mem_referenceSimplexCoordinateLine_orthogonal_iff i x).2 hcoord.2
  exact ⟨⟨x, hxorth⟩, rfl⟩

/--
Pushforward of restricted orthogonal-hyperplane volume equals the geometric
surface measure of the reference coordinate facet.
-/
theorem referenceSimplex_coordinateFacetSurfaceMeasure_eq_map
    {d : Nat} [NeZero d] (i : Fin d) :
    (volume.restrict (referenceSimplexFiberBaseDomain i)).map
        (fun y : (referenceSimplexCoordinateLine i)ᗮ =>
          (y : EuclideanDomain d)) =
      geometricSimplexFacetSurfaceMeasure
        (referenceGeometricSimplex d) i.succ := by
  let S := (referenceSimplexCoordinateLine i)ᗮ
  let incl : S → EuclideanDomain d := fun y => (y : EuclideanDomain d)
  have hSclosed : IsClosed (S : Set (EuclideanDomain d)) :=
    S.isClosed
  have hemb : MeasurableEmbedding incl := by
    exact MeasurableEmbedding.subtype_coe hSclosed.measurableSet
  have hfin : Module.finrank ℝ S = d - 1 := by
    simpa [S] using referenceSimplexCoordinateLine_orthogonal_finrank i
  have hvol :
      (volume : Measure S) =
        (μHE[d - 1] : Measure S) := by
    simpa [hfin] using
      (InnerProductSpace.euclideanHausdorffMeasure_eq_volume
        (V := S)).symm
  have hmap :
      (μHE[d - 1] : Measure S).map incl =
        (μHE[d - 1] : Measure (EuclideanDomain d)).restrict
          (Set.range incl) := by
    simpa [incl] using
      (isometry_subtype_coe.map_euclideanHausdorffMeasure
        (X := S) (Y := EuclideanDomain d) (d := d - 1))
  have hpre :
      incl ⁻¹'
          geometricSimplexFacet (referenceGeometricSimplex d) i.succ =
        referenceSimplexFiberBaseDomain i := by
    simpa [S, incl] using referenceSimplex_coordinateFacet_preimage i
  have hsubset :
      geometricSimplexFacet (referenceGeometricSimplex d) i.succ ⊆
        Set.range incl := by
    simpa [S, incl] using
      referenceSimplex_coordinateFacet_subset_orthogonal_range i
  calc
    (volume.restrict (referenceSimplexFiberBaseDomain i)).map incl =
        ((μHE[d - 1] : Measure S).restrict
          (referenceSimplexFiberBaseDomain i)).map incl := by
      rw [hvol]
    _ =
        ((μHE[d - 1] : Measure S).restrict
          (incl ⁻¹'
            geometricSimplexFacet
              (referenceGeometricSimplex d) i.succ)).map incl := by
      rw [hpre]
    _ =
        ((μHE[d - 1] : Measure S).map incl).restrict
          (geometricSimplexFacet
            (referenceGeometricSimplex d) i.succ) := by
      exact
        (hemb.restrict_map
          (μHE[d - 1] : Measure S)
          (geometricSimplexFacet
            (referenceGeometricSimplex d) i.succ)).symm
    _ =
        ((μHE[d - 1] : Measure (EuclideanDomain d)).restrict
          (Set.range incl)).restrict
            (geometricSimplexFacet
              (referenceGeometricSimplex d) i.succ) := by
      rw [hmap]
    _ =
        (μHE[d - 1] : Measure (EuclideanDomain d)).restrict
          (geometricSimplexFacet
            (referenceGeometricSimplex d) i.succ) := by
      simp [Measure.restrict_restrict, Set.inter_eq_right.2 hsubset]
    _ =
        geometricSimplexFacetSurfaceMeasure
          (referenceGeometricSimplex d) i.succ := rfl

end

end Continuum

end CACEFormal
