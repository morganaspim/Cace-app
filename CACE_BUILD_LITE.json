{
  "schema": "cace.build-lite.v1",
  "version": "1.0.0",
  "purpose": "Low-cost deterministic build/test planning for human and AI code builders. Never proof evidence.",
  "profiles": {
    "quick": "Fast edit-loop checks selected from changed paths.",
    "merge": "Broader regression before merge.",
    "proof": "Formal-source preflight planning; caches restore only and never create qualification."
  },
  "tasks": [
    {
      "id": "python_syntax",
      "deps": [],
      "triggers": [
        "cace_studio/**/*.py",
        "api/**/*.py",
        "scripts/**/*.py",
        "tests/**/*.py"
      ],
      "cache_inputs": [
        "cace_studio/**/*.py",
        "api/**/*.py",
        "scripts/**/*.py"
      ],
      "command": "python -m compileall -q cace_studio api scripts",
      "executor": "local",
      "estimated_seconds": 4,
      "cpu_units": 1,
      "priority": 100,
      "fail_fast": true,
      "proof_sensitive": false,
      "cache_policy": "skip_on_exact_hit",
      "profiles": [
        "quick",
        "merge"
      ]
    },
    {
      "id": "trial_account_policy",
      "deps": [
        "python_syntax"
      ],
      "triggers": [
        "CACE_TRIAL_ACCOUNT_POLICY.json",
        "cace_studio/trial_entitlement.py",
        "cace_studio/accounts.py",
        "docs/TRIAL_AND_ACCOUNT_UNIQUENESS.md",
        "tests/test_trial_entitlement.py",
        "tests/test_trial_account_policy.py",
        "scripts/check_trial_account_policy.py"
      ],
      "cache_inputs": [
        "CACE_TRIAL_ACCOUNT_POLICY.json",
        "cace_studio/trial_entitlement.py",
        "scripts/check_trial_account_policy.py",
        "tests/test_trial_entitlement.py",
        "tests/test_trial_account_policy.py"
      ],
      "command": "python scripts/check_trial_account_policy.py && python -m pytest -q tests/test_trial_entitlement.py tests/test_trial_account_policy.py",
      "executor": "local",
      "estimated_seconds": 6,
      "cpu_units": 1,
      "priority": 155,
      "fail_fast": true,
      "proof_sensitive": false,
      "cache_policy": "skip_on_exact_hit",
      "profiles": [
        "quick",
        "merge"
      ]
    },
    {
      "id": "public_help_contract",
      "deps": [
        "python_syntax"
      ],
      "triggers": [
        "CACE_PUBLIC_HELP_POLICY.json",
        "docs/help/**",
        "cace_studio/public_help.py",
        "scripts/generate_public_help.py",
        "scripts/check_public_help.py",
        "tests/test_public_help.py",
        "cace_studio/modules/**",
        "cace_studio/core/types.py",
        "cace_studio/core/registry.py"
      ],
      "cache_inputs": [
        "CACE_PUBLIC_HELP_POLICY.json",
        "docs/help/**",
        "cace_studio/public_help.py",
        "scripts/check_public_help.py",
        "tests/test_public_help.py",
        "cace_studio/modules/**",
        "cace_studio/core/types.py",
        "cace_studio/core/registry.py"
      ],
      "command": "python scripts/check_public_help.py && python -m pytest -q tests/test_public_help.py",
      "executor": "local",
      "estimated_seconds": 12,
      "cpu_units": 1,
      "priority": 145,
      "fail_fast": true,
      "proof_sensitive": false,
      "cache_policy": "skip_on_exact_hit",
      "profiles": [
        "quick",
        "merge"
      ]
    },
    {
      "id": "deployment_boundary_policy",
      "deps": [
        "python_syntax"
      ],
      "triggers": [
        "CACE_DEPLOYMENT_BOUNDARY.json",
        "docs/SECURITY_ARCHITECTURE.md",
        "docs/WEBAPP_HARDENED_LOCAL_LAYER.md",
        "api/**",
        "web/**",
        "deploy/**",
        "tests/test_deployment_boundary_policy.py",
        "scripts/check_deployment_boundary.py"
      ],
      "cache_inputs": [
        "CACE_DEPLOYMENT_BOUNDARY.json",
        "scripts/check_deployment_boundary.py",
        "tests/test_deployment_boundary_policy.py"
      ],
      "command": "python scripts/check_deployment_boundary.py && python -m pytest -q tests/test_deployment_boundary_policy.py",
      "executor": "local",
      "estimated_seconds": 4,
      "cpu_units": 1,
      "priority": 150,
      "fail_fast": true,
      "proof_sensitive": false,
      "cache_policy": "skip_on_exact_hit",
      "profiles": [
        "quick",
        "merge"
      ]
    },
    {
      "id": "web_api_smoke",
      "deps": [
        "python_syntax"
      ],
      "triggers": [
        "api/**",
        "web/**",
        "tests/test_web_api.py"
      ],
      "cache_inputs": [
        "api/**/*.py",
        "web/**/*",
        "tests/test_web_api.py"
      ],
      "command": "python -m pytest -q tests/test_web_api.py",
      "executor": "local",
      "estimated_seconds": 10,
      "cpu_units": 1,
      "priority": 30,
      "fail_fast": true,
      "proof_sensitive": false,
      "cache_policy": "skip_on_exact_hit",
      "profiles": [
        "quick",
        "merge"
      ]
    },
    {
      "id": "targeted_python_tests",
      "deps": [
        "python_syntax"
      ],
      "triggers": [
        "cace_studio/**/*.py",
        "tests/**/*.py"
      ],
      "cache_inputs": [
        "cace_studio/**/*.py",
        "tests/**/*.py",
        "pyproject.toml"
      ],
      "command": "python -m pytest -q",
      "executor": "local",
      "estimated_seconds": 45,
      "cpu_units": 2,
      "priority": 20,
      "fail_fast": false,
      "proof_sensitive": false,
      "cache_policy": "skip_on_exact_hit",
      "profiles": [
        "quick",
        "merge"
      ]
    },
    {
      "id": "lean_source_sanity",
      "deps": [],
      "triggers": [
        "formal/**/*.lean",
        "formal/**/*.json",
        "scripts/cace_proof_guardrails.py",
        ".github/workflows/*lean*"
      ],
      "cache_inputs": [
        "formal/**/*.lean",
        "formal/**/*.json",
        "scripts/cace_proof_guardrails.py",
        ".github/workflows/*lean*"
      ],
      "command": "python scripts/check_lean_source_sanity.py --self-test",
      "executor": "local",
      "estimated_seconds": 8,
      "cpu_units": 1,
      "priority": 200,
      "fail_fast": true,
      "proof_sensitive": true,
      "cache_policy": "restore_only",
      "profiles": [
        "quick",
        "merge",
        "proof"
      ]
    },
    {
      "id": "proof_contract_tests",
      "deps": [
        "lean_source_sanity"
      ],
      "triggers": [
        "formal/**",
        "cace_studio/data/proof_contracts.json",
        "tests/test_cace_proof_guardrails.py",
        "tests/test_proof_contract_v336.py"
      ],
      "cache_inputs": [
        "formal/**",
        "cace_studio/data/proof_contracts.json",
        "tests/test_cace_proof_guardrails.py",
        "tests/test_proof_contract_v336.py"
      ],
      "command": "python -m pytest -q tests/test_cace_proof_guardrails.py tests/test_proof_contract_v336.py",
      "executor": "local",
      "estimated_seconds": 15,
      "cpu_units": 1,
      "priority": 180,
      "fail_fast": true,
      "proof_sensitive": true,
      "cache_policy": "restore_only",
      "profiles": [
        "quick",
        "merge",
        "proof"
      ]
    },
    {
      "id": "lean_exact_pin_impacted",
      "deps": [
        "proof_contract_tests"
      ],
      "triggers": [
        "formal/**/*.lean"
      ],
      "cache_inputs": [
        "formal/**/*.lean",
        "formal/lean-toolchain",
        "formal/cace_formal/lake-manifest.json"
      ],
      "command": "workflow:CACE Exact-Pin Lean Preflight (impacted modules; exact head)",
      "executor": "github_actions",
      "estimated_seconds": 180,
      "cpu_units": 4,
      "priority": 100,
      "fail_fast": false,
      "proof_sensitive": true,
      "cache_policy": "restore_only",
      "profiles": [
        "proof"
      ]
    },
    {
      "id": "python_full_regression",
      "deps": [
        "targeted_python_tests",
        "web_api_smoke",
        "deployment_boundary_policy",
        "public_help_contract",
        "trial_account_policy"
      ],
      "triggers": [
        "cace_studio/**",
        "api/**",
        "web/**",
        "tests/**",
        "pyproject.toml"
      ],
      "cache_inputs": [
        "cace_studio/**",
        "api/**",
        "web/**",
        "tests/**",
        "pyproject.toml"
      ],
      "command": "workflow:CACE Python regression",
      "executor": "github_actions",
      "estimated_seconds": 120,
      "cpu_units": 4,
      "priority": 10,
      "fail_fast": false,
      "proof_sensitive": false,
      "cache_policy": "none",
      "profiles": [
        "merge"
      ]
    }
  ]
}
